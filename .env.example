# Copy to .env and fill in real values. Never commit .env or .env.* files.

PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/aegis3d?appName=AEGIS
# When Atlas is unreachable (IP allowlist / DNS), local dev falls back to in-memory Mongo.
# Set to false to fail hard instead.
MONGODB_ALLOW_MEMORY_FALLBACK=true
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

# Session signing (change in every deployed environment)
AUTH_SESSION_SECRET=change-me-to-a-long-random-string
AUTH_SESSION_TTL=28800
AUTH_REMEMBER_ME_TTL=2592000
